{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XGTools",
  "version": "0.8.4",
  "identifier": "com.tauri-app.xgtools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "XGTools",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "transparent": true
      },
      {
        "label": "key_visualizer",
        "title": "key_visualizer",
        "url": "index.html",
        "width": 270,
        "height": 300,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      },
      {
        "label": "dock",
        "url": "index.html",
        "maximizable": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "palette",
        "url": "index.html",
        "width": 720,
        "height": 64,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      },
      {
        "label": "screenshot",
        "title": "XGTools Screenshot Overlay",
        "url": "index.html",
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "width": 1,
        "height": 1,
        "visible": false,
        "focus": false,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "tray-menu",
        "url": "index.html",
        "title": "XGTools",
        "width": 230,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ocr/*": "resources/ocr/",
      "resources/ffmpeg/*": "resources/ffmpeg/"
    }
  }
}
