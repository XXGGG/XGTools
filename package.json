{
  "name": "xgtools",
  "private": true,
  "version": "0.8.4",
  "type": "module",
  "scripts": {
    "bump": "node scripts/bump.mjs",
    "fonts": "node scripts/gen-hand-font-css.mjs",
    "bergamot": "node scripts/copy-bergamot.mjs",
    "dist": "pnpm tauri build && node scripts/collect-installer.mjs",
    "predev": "pnpm fonts && pnpm bergamot",
    "dev": "vite",
    "prebuild": "pnpm fonts && pnpm bergamot",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "open:bundle": "explorer src-tauri\\target\\release\\bundle",
    "tauri:build": "tauri build && if exist release rd /s /q release & mkdir release && for %f in (src-tauri\\target\\release\\bundle\\nsis\\*setup.exe) do copy /Y \"%f\" release\\ & for %f in (src-tauri\\target\\release\\bundle\\msi\\*en-US.msi) do copy /Y \"%f\" release\\"
  },
  "dependencies": {
